# Копируйте в .env и задайте значения

JWT_SECRET=your-secret-key-min-32-chars
# Пароль admin (приложение + Grafana). Сгенерируйте: python3 -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits+'#@!%&*-_') for _ in range(32)))"
ADMIN_PASSWORD=

# --- HTTPS (Caddy + Let's Encrypt) ---
APP_DOMAIN=trend-logistics.ru
ACME_EMAIL=admin@trend-logistics.ru
GRAFANA_ROOT_URL=https://trend-logistics.ru/grafana/
MONITORING_URL=/grafana/

# Локальная отладка без Caddy (только с сервера): http://127.0.0.1:3000
APP_PUBLISH_PORT=3000

PROMETHEUS_PORT=9090

# --- Локальная разработка без Docker: SQLite + без Redis/ClickHouse ---
# DATABASE_URL=sqlite+aiosqlite:///./trend_logistics.db
# REDIS_URL=
# CLICKHOUSE_HOST=

# --- Docker Compose (значения задаются в compose по умолчанию) ---
# DATABASE_URL=postgresql+asyncpg://trend:trend@postgres:5432/trend_logistics
# REDIS_URL=redis://redis:6379/0
# CLICKHOUSE_HOST=clickhouse
# CLICKHOUSE_DATABASE=trend

# Кэш ответа external_data в Redis (секунды)
FACTORS_CACHE_TTL_SECONDS=1800

# --- Сервис внешних данных ---
EXTERNAL_DATA_USE_LIVE_WEATHER=false
EXTERNAL_DATA_USE_LIVE_TRAFFIC=false
EXTERNAL_DATA_USE_LIVE_GEOPOLITICS=false

# TELEMETRY_SERVICE_URL=http://telemetry:8002
